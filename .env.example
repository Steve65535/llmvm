# LLM provider
DEEPSEEK_API_KEY=

# Runtime context budget, in tokens.
# Default: 64000
CONTEXT_BUDGET=64000

# Planned TUI defaults. These are optional until the TUI implementation lands.
LLMVM_SAVE_PATH=state.json
LLMVM_LOAD_PATH=
LLMVM_SQLITE_PATH=
LLMVM_TUI_AUTOSAVE=true
LLMVM_TUI_AUTOSAVE_INTERVAL_SECONDS=30
LLMVM_TUI_EVENT_BUFFER_SIZE=1000
LLMVM_TUI_LOG_LEVEL=info
LLMVM_TUI_RAW_OUTPUT=false
