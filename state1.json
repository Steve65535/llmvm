        "Variables": {
          "_artifact_view": "[art_24 lines 1-0]\npackage core\n\nimport (\n\t\"encoding/json\"\n\t\"math\"\n\t\"sync\"\n\n\t\"github.com/google/uuid\"\n)\n\n// Vector represents an embedding vector with an ID, values, and optional metadata.\ntype Vector struct {\n\tID       string                 `json:\"id\"`\n\tValues   []float64              `json:\"values\"`\n\tMetadata map[string]interface{} `json:\"metadata,omitempty\"`\n}\n\n// NewVector creates a new Vector. If id is empty, a UUID is generated.\nfunc NewVector(id string, values []float64, metadata map[string]interface{}) *Vector {\n\tif id == \"\" {\n\t\tid = uuid.New().String()\n\t}\n\tif metadata == nil {\n\t\tmetadata = make(map[string]interface{})\n\t}\n\treturn \u0026Vector{\n\t\tID:       id,\n\t\tValues:   values,\n\t\tMetadata: metadata,\n\t}\n}\n\n// Dimension returns the number of dimensions of the vector.\nfunc (v *Vector) Dimension() int {\n\treturn len(v.Values)\n}\n\n// Validate checks if the vector has at least one dimension.\nfunc (v *Vector) Validate() error {\n\tif len(v.Values) == 0 {\n\t\treturn ErrEmptyVector\n\t}\n\treturn nil\n}\n\n// Document represents a document with text content and an associated embedding vector.\ntype Document struct {\n\tID       string                 `json:\"id\"`\n\tContent  string                 `json:\"content\"`\n\tMetadata map[string]interface{} `json:\"metadata,omitempty\"`",
